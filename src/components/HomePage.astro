---
import Layout from "../layouts/Layout.astro";
import { projects, staticSites, skills } from "../data/portfolio";
import type { Language } from "../types";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;

const categoryLabels: Record<Language, Record<string, string>> = {
	en: { lang: "Languages", frontend: "Frontend", backend: "Backend", data: "Data & Storage", systems: "Systems" },
	fr: { lang: "Langages", frontend: "Frontend", backend: "Backend", data: "Données & Stockage", systems: "Système" },
};

const t = {
	en: {
		title: "Yanis Amani — Software Engineering Student & Portfolio",
		description: "Official portfolio of Yanis Amani, Software Engineering student. Building reliable software in Rust, TypeScript, and systems programming.",
		badge: "Software Engineering Student · Systems · Web · Reliability",
		heroDesc: "I build reliable software. Rust, TypeScript, systems programming. The kind that doesn't fall over in production.",
		ctaProjects: "View projects",
		ctaContact: "Get in touch",
		heroMeta: "HE-Arc · Neuchâtel, Switzerland",
		caseStudy: "Case study →",
		projects: "Projects",
		projectsSub: "Side projects, open-source tools, and things I built because they were interesting problems.",
		staticSites: "Static Sites",
		staticSub: "Client projects: clean, professional web presence.",
		skills: "Skills",
		skillsSub: "Languages and frameworks I reach for daily.",
		about: "About",
		aboutSub: "How I think about building software.",
		aboutText: `I care about the boring stuff. Good error handling, clean interfaces, code that's still readable six months later. I've broken enough things in production to know that "it works on my machine" is not a testing strategy. These days I'd rather go slow and get it right.`,
		values: ["Reliability", "Performance", "Security"],
		contact: "Get in Touch",
		contactSub: "Got a project, an idea, or just want to chat? I'm around.",
	},
	fr: {
		title: "Yanis Amani — Étudiant Ingénieur Logiciel & Portfolio",
		description: "Portfolio officiel de Yanis Amani, étudiant ingénieur logiciel. Conception de logiciels fiables en Rust, TypeScript et programmation système.",
		badge: "Étudiant Ingénieur Logiciel · Systèmes · Web · Fiabilité",
		heroDesc: "Je construis des logiciels fiables. Rust, TypeScript, programmation système. Le genre qui tient la route en production.",
		ctaProjects: "Voir les projets",
		ctaContact: "Me contacter",
		heroMeta: "HE-Arc · Neuchâtel, Suisse",
		caseStudy: "Étude de cas →",
		projects: "Projets",
		projectsSub: "Projets perso, outils open-source, des trucs construits parce que le problème était intéressant.",
		staticSites: "Sites statiques",
		staticSub: "Projets clients : présence web propre et professionnelle.",
		skills: "Compétences",
		skillsSub: "Langages et frameworks que j'utilise quotidiennement.",
		about: "À propos",
		aboutSub: "Comment je pense le développement logiciel.",
		aboutText: "Je me soucie des trucs ennuyeux. La gestion d'erreurs propre, des interfaces claires, du code qui se relit encore six mois après. J'ai assez cassé de choses en production pour savoir que « ça marche sur ma machine » n'est pas une stratégie de test. Maintenant je préfère aller lentement mais bien faire les choses.",
		values: ["Fiabilité", "Performance", "Sécurité"],
		contact: "Me contacter",
		contactSub: "Un projet, une idée, ou juste envie de parler ? Je suis là.",
	},
}[lang];

const projectBase = lang === "fr" ? "/fr/projects" : "/projects";

// WIE leads: 64-bit Windows emulation earns the featured wide card
const featured = projects.find((p) => p.id === "wie") || projects[0];
const others = projects.filter((p) => p.id !== featured.id);
const orderedProjects = [featured, ...others];

// Strongest skills first within each group
const levelRank: Record<string, number> = { Advanced: 0, Proficient: 1, Intermediate: 2 };
const skillsByCat = skills.reduce((acc, s) => {
	if (!acc[s.category]) acc[s.category] = [];
	acc[s.category].push(s);
	return acc;
}, {} as Record<string, typeof skills>);
for (const cat of Object.keys(skillsByCat)) {
	skillsByCat[cat].sort((a, b) => (levelRank[a.level.en] ?? 9) - (levelRank[b.level.en] ?? 9));
}
---

<Layout title={t.title} description={t.description} lang={lang}>
	<!-- MARQUEE HERO -->
	<section class="marquee-hero">
		<div class="container marquee-hero__inner" data-animate>
			<span class="marquee-hero__badge">{t.badge}</span>
			<h1 class="marquee-hero__title">Yanis <span class="marquee-hero__accent">Amani</span></h1>
			<p class="marquee-hero__desc">{t.heroDesc}</p>
			<div class="marquee-hero__cta">
				<a href="#projects" class="btn-primary">{t.ctaProjects}</a>
				<a href="#contact" class="btn-ghost">{t.ctaContact}</a>
			</div>
			<p class="marquee-hero__meta">{t.heroMeta}</p>
		</div>
	</section>

	<hr class="section-divider" />

	<!-- PROJECTS -->
	<section id="projects" class="section marquee-section">
		<div class="container">
			<div class="section__head">
				<h2 class="section__title">{t.projects}</h2>
				<p class="section__sub">{t.projectsSub}</p>
			</div>
			<div class="project-grid">
				{orderedProjects.map((p, i) => (
					<article class={`project-card${i === 0 ? " project-card--featured" : ""}`}>
						<span class="project-card__cat">{p.category[lang]}</span>
						<h3 class="project-card__name">
							<a href={`${projectBase}/${p.id}`} class="project-card__link">{p.name}</a>
						</h3>
						<p class="project-card__desc">{p.description[lang]}</p>
						<div class="project-card__foot">
							<div class="project-card__tags">
								{p.tags.map((tag) => (
									<a href={tag.url} target="_blank" rel="noopener noreferrer" class="tech-tag">{tag.name}</a>
								))}
							</div>
							<span class="project-card__more" aria-hidden="true">{t.caseStudy}</span>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- STATIC SITES -->
	<section class="section marquee-section">
		<div class="container">
			<div class="section__head">
				<h2 class="section__title">{t.staticSites}</h2>
				<p class="section__sub">{t.staticSub}</p>
			</div>
			<div class="static-grid">
				{staticSites.map((site) => (
					<a href={site.url} target="_blank" rel="noopener noreferrer" class="static-card">
						<h3 class="static-card__name">{site.name}</h3>
						<p class="static-card__desc">{site.description[lang]}</p>
						<div class="static-card__tags">
							{site.tags.map((tag) => (
								<span class="mini-tag">{tag}</span>
							))}
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<hr class="section-divider" />

	<!-- SKILLS -->
	<section id="skills" class="section marquee-section">
		<div class="container container--narrow">
			<div class="section__head">
				<h2 class="section__title">{t.skills}</h2>
				<p class="section__sub">{t.skillsSub}</p>
			</div>
			<div class="skill-groups">
				{Object.entries(skillsByCat).map(([cat, catSkills]) => (
					<div class="skill-group">
						<span class="skill-group__label">{categoryLabels[lang][cat] || cat}</span>
						<div class="skill-group__chips">
							{catSkills.map((s) => (
								<span class="skill-chip" data-category={s.category}>{s.name}</span>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ABOUT -->
	<section id="about" class="section marquee-section">
		<div class="container container--narrow">
			<div class="section__head">
				<h2 class="section__title">{t.about}</h2>
				<p class="section__sub">{t.aboutSub}</p>
			</div>
			<div class="about-body">
				<p class="about-text">{t.aboutText}</p>
				<div class="values-row">
					{t.values.map((v) => (
						<span class="value-chip">{v}</span>
					))}
				</div>
			</div>
		</div>
	</section>

	<hr class="section-divider" />

	<!-- CONTACT -->
	<section id="contact" class="section marquee-section">
		<div class="container container--narrow">
			<div class="contact-card">
				<h2 class="contact-card__title">{t.contact}</h2>
				<p class="contact-card__sub">{t.contactSub}</p>
				<div class="contact-card__body">
					<a href="mailto:yanis.amani@icloud.com" class="contact-card__email">yanis.amani@icloud.com</a>
					<div class="contact-card__socials">
						<a href="https://linkedin.com/in/yanis-amani" target="_blank" rel="noopener noreferrer" class="contact-card__social">LinkedIn</a>
						<a href="https://github.com/DevYatsu" target="_blank" rel="noopener noreferrer" class="contact-card__social">GitHub</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
/* ═══════════════════════════════════════════
   Hallmark · genre: modern-minimal · macrostructure: Marquee Hero
   design-system: design.md · designed-as-app
   hero knobs: left-bias · typography only · featured-card grid
   pre-emit critique: P5 H5 E5 S5 R4 V5 · contrast: pass (40–41)
   nav: N1b · footer: Ft5 · slop: pass (42–45) · honest: pass (46)
   ═══════════════════════════════════════════ */

/* ── Marquee Hero ── */
.marquee-hero {
  min-height: 85vh;
  display: flex;
  align-items: center;
  position: relative;
}

.marquee-hero__inner {
  position: relative;
  z-index: 1;
  width: 100%;
}

.marquee-hero__badge {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-accent);
  margin-bottom: var(--space-md);
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

.marquee-hero__title {
  font-family: var(--font-display);
  font-size: clamp(3.25rem, 8vw + 0.5rem, 6.5rem);
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 0.9;
  margin-bottom: var(--space-md);
  max-width: 8ch;
  overflow-wrap: anywhere;
  min-width: 0;
}

.marquee-hero__accent {
  color: var(--color-accent);
  font-style: normal;
}

.marquee-hero__desc {
  font-size: var(--text-md);
  color: var(--color-muted);
  line-height: 1.65;
  max-width: 34rem;
  font-family: var(--font-body);
  margin-bottom: 0;
}

.marquee-hero__cta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.marquee-hero__meta {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-muted);
  letter-spacing: 0.02em;
  margin-top: var(--space-xl);
}

@media (min-width: 768px) {
  .marquee-hero__desc { font-size: var(--text-lg); }
  .marquee-hero__title { font-size: clamp(4rem, 8vw + 0.5rem, 7rem); }
}

/* ── Section Headers ── */
.section__head {
  margin-bottom: var(--space-lg);
}

.section__title {
  font-size: var(--text-2xl);
  font-weight: 600;
  margin-bottom: var(--space-2xs);
}

.section__sub {
  font-size: var(--text-base);
  color: var(--color-muted);
  max-width: 32rem;
  line-height: 1.6;
  font-family: var(--font-body);
}

/* ── Project Cards ── */
.project-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-md);
}

@media (min-width: 768px) {
  .project-grid {
    grid-template-columns: 1fr 1fr;
  }
}

.project-card {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: var(--space-lg);
  border: 1px solid var(--color-rule);
  border-radius: var(--radius-lg);
  background: var(--color-paper-2);
  color: inherit;
  transition: border-color var(--dur-short) var(--ease-out);
}

.project-card:hover {
  border-color: var(--color-accent);
}

/* The featured project spans the full row: YatsuScript earns the space */
@media (min-width: 768px) {
  .project-card--featured {
    grid-column: 1 / -1;
    padding: var(--space-xl);
  }

  .project-card--featured .project-card__name {
    font-size: var(--text-display-s);
    letter-spacing: -0.03em;
  }

  .project-card--featured .project-card__desc {
    font-size: var(--text-base);
    max-width: 44rem;
  }
}

/* Stretched link: the whole card is clickable without nesting anchors */
.project-card__link {
  color: inherit;
  text-decoration: none;
}

.project-card__link::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: var(--radius-lg);
}

.project-card__link:focus-visible {
  outline: none;
}

.project-card__link:focus-visible::after {
  outline: 2px solid var(--color-focus);
  outline-offset: 2px;
}

.project-card__cat {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-muted);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: var(--space-2xs);
}

.project-card__name {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 600;
  margin-bottom: var(--space-2xs);
  letter-spacing: -0.02em;
}

@media (min-width: 768px) {
  .project-card__name { font-size: var(--text-2xl); }
}

.project-card__desc {
  font-size: var(--text-sm);
  color: var(--color-muted);
  line-height: 1.6;
  margin-bottom: var(--space-sm);
  font-family: var(--font-body);
}

.project-card__foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-top: auto;
}

.project-card__tags {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2xs);
}

.project-card__more {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-muted);
  white-space: nowrap;
  transition: color var(--dur-short) var(--ease-out);
}

.project-card:hover .project-card__more {
  color: var(--color-accent);
}

/* ── Static Sites Grid ── */
.static-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1px;
  background: var(--color-rule);
  border: 1px solid var(--color-rule);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

@media (min-width: 640px) {
  .static-grid { grid-template-columns: repeat(2, 1fr); }

  /* Odd count: the leftover card spans both columns so no empty cell
     shows the rule-colored grid background through the 1px gap */
  .static-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
}

.static-card {
  display: flex;
  flex-direction: column;
  padding: var(--space-md);
  background: var(--color-paper);
  text-decoration: none;
  color: inherit;
  transition: background var(--dur-short) var(--ease-out);
}

.static-card:hover {
  background: var(--color-paper-2);
}

.static-card__name {
  font-family: var(--font-display);
  font-size: var(--text-base);
  font-weight: 600;
  margin-bottom: var(--space-2xs);
}

/* External-link marker: these open the client's live site */
.static-card__name::after {
  content: " ↗";
  color: var(--color-muted);
  font-weight: 400;
  transition: color var(--dur-short) var(--ease-out);
}

.static-card:hover .static-card__name::after {
  color: var(--color-accent);
}

.static-card__desc {
  font-size: var(--text-sm);
  color: var(--color-muted);
  line-height: 1.5;
  margin-bottom: var(--space-sm);
  font-family: var(--font-body);
}

.static-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2xs);
  margin-top: auto;
}

/* ── Skill Groups ── */
.skill-groups {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.skill-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
}

.skill-group__label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 500;
}

.skill-group__chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2xs);
}

/* ── About ── */
.about-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.about-text {
  font-size: var(--text-md);
  color: var(--color-ink-2);
  line-height: 1.7;
  font-family: var(--font-body);
  max-width: 48rem;
}

@media (min-width: 768px) {
  .about-text { font-size: var(--text-lg); }
}

.values-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.value-chip {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-display);
  font-size: var(--text-base);
  font-weight: 600;
  padding: var(--space-2xs) var(--space-sm);
  border: 1px solid var(--color-rule);
  border-radius: var(--radius-pill);
  color: var(--color-ink);
  background: var(--color-paper-2);
}

/* ── Contact ── */
.contact-card {
  padding: var(--space-xl) 0;
}

.contact-card__title {
  font-size: var(--text-2xl);
  margin-bottom: var(--space-2xs);
}

.contact-card__sub {
  font-size: var(--text-base);
  color: var(--color-muted);
  margin-bottom: var(--space-lg);
  font-family: var(--font-body);
}

.contact-card__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  align-items: flex-start;
}

/* The email is the page's closing object: display-sized, unmissable */
.contact-card__email {
  font-family: var(--font-display);
  font-size: clamp(1.375rem, 3.5vw, 2.25rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--color-accent);
  text-decoration: none;
  overflow-wrap: anywhere;
  min-width: 0;
  transition: opacity var(--dur-short) var(--ease-out);
}

.contact-card__email:hover {
  opacity: 0.75;
}

.contact-card__email:focus-visible {
  outline: 2px solid var(--color-focus);
  outline-offset: 2px;
}

.contact-card__socials {
  display: flex;
  gap: var(--space-md);
}

.contact-card__social {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--color-ink-2);
  text-decoration: none;
  transition: color var(--dur-short) var(--ease-out);
}

.contact-card__social:hover {
  color: var(--color-accent);
}

/* ── Responsive tweaks ── */
@media (max-width: 767px) {
  .marquee-hero__title {
    font-size: clamp(2.5rem, 10vw, 3.75rem);
  }
}
</style>
