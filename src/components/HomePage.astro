---
import Layout from "../layouts/Layout.astro";
import { projects, staticSites, skills, layers, lineage } from "../data/portfolio";
import type { Language } from "../types";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;

const categoryLabels: Record<Language, Record<string, string>> = {
	en: { lang: "Languages", frontend: "Frontend", backend: "Backend", data: "Data & Storage", systems: "Systems" },
	fr: { lang: "Langages", frontend: "Frontend", backend: "Backend", data: "Données & Stockage", systems: "Système" },
};

const t = {
	en: {
		title: "Yanis Amani: Computer Science Student, Neuchâtel",
		description: "BSc Computer Science student at HE-Arc in Neuchâtel, Switzerland. I build in Rust and TypeScript, from websites to a JavaScript engine and a Windows emulator.",
		eyebrow: "BSc Computer Science student, HE-Arc",
		statement: "From the pixel to the register.",
		heroDesc: "I build every layer of the stack: websites, full products, programming languages, a JavaScript engine, and a Windows emulator for Apple Silicon.",
		ctaProjects: "Start the descent",
		ctaContact: "Get in touch",
		stairLabel: "The five layers of this portfolio",
		gaugeLabel: "Depth",
		about: "About",
		aboutLead: "My name is Yanis Amani. I'm pursuing a BSc in Computer Science with a major in Software Engineering at HE-Arc in Neuchâtel, Switzerland.",
		aboutStory: "In 2023 I wrote JadeFlow, my first programming language, because I just wanted to understand how languages work. Understanding one layer exposed the next one down, so I kept digging: compilers, virtual machines, a JavaScript engine, then the instructions themselves.",
		aboutText: `I care about the boring stuff. Good error handling, clean interfaces, code that's still readable six months later. I've broken enough things in production to know that "it works on my machine" is not a testing strategy. These days I'd rather go slow and get it right.`,
		factsLabel: "At a glance",
		facts: [
			["Based in", "Neuchâtel, Switzerland"],
			["Studying", "BSc Computer Science, Software Engineering major, HE-Arc"],
			["Main tools", "Rust, TypeScript"],
			["Cares about", "Reliability, performance, security"],
		],
		skills: "Stack",
		skillsSub: "Languages and tools I reach for, strongest first.",
		caseStudy: "Case study →",
		lineage: "Five languages since 2023",
		bottom: "Bottom of the stack",
		contact: "End of the descent. Say hello.",
		contactSub: "Got a project, an idea, or a low-level problem you want to talk through? I'm around.",
	},
	fr: {
		title: "Yanis Amani : étudiant en informatique, Neuchâtel",
		description: "Bachelor en informatique à la HE-Arc, Neuchâtel (Suisse). Je développe en Rust et TypeScript, du site web au moteur JavaScript et à l'émulateur Windows.",
		eyebrow: "Bachelor en informatique, HE-Arc",
		statement: "Du pixel au registre.",
		heroDesc: "Je construis chaque couche de la pile : sites web, produits complets, langages de programmation, un moteur JavaScript et un émulateur Windows pour Apple Silicon.",
		ctaProjects: "Commencer la descente",
		ctaContact: "Me contacter",
		stairLabel: "Les cinq couches de ce portfolio",
		gaugeLabel: "Profondeur",
		about: "À propos",
		aboutLead: "Je m'appelle Yanis Amani. Je prépare un Bachelor en informatique, spécialisation génie logiciel, à la HE-Arc à Neuchâtel, en Suisse.",
		aboutStory: "En 2023, j'ai écrit JadeFlow, mon premier langage de programmation, simplement pour comprendre comment marchent les langages. Comprendre une couche révélait la suivante, alors j'ai continué à creuser : compilateurs, machines virtuelles, un moteur JavaScript, puis les instructions elles-mêmes.",
		aboutText: "Je me soucie des trucs ennuyeux. La gestion d'erreurs propre, des interfaces claires, du code qui se relit encore six mois après. J'ai assez cassé de choses en production pour savoir que « ça marche sur ma machine » n'est pas une stratégie de test. Maintenant je préfère aller lentement mais bien faire les choses.",
		factsLabel: "En bref",
		facts: [
			["Basé à", "Neuchâtel, Suisse"],
			["Études", "Bachelor en informatique, spécialisation génie logiciel, HE-Arc"],
			["Outils principaux", "Rust, TypeScript"],
			["Priorités", "Fiabilité, performance, sécurité"],
		],
		skills: "Stack",
		skillsSub: "Les langages et outils que j'utilise, les plus solides d'abord.",
		caseStudy: "Étude de cas →",
		lineage: "Cinq langages depuis 2023",
		bottom: "Le fond de la pile",
		contact: "Fin de la descente. Dites bonjour.",
		contactSub: "Un projet, une idée, ou un problème bas niveau à discuter ? Je suis là.",
	},
}[lang];

const projectBase = lang === "fr" ? "/fr/projects" : "/projects";

const projectsIn = (layer: string) => projects.filter((p) => p.layer === layer);

// Each stair row names its proof, so the hero alone explains the whole page
const stairProof: Record<string, string> = {
	surface: staticSites.map((s) => s.name).join(", "),
	product: projectsIn("product").map((p) => p.name).join(", "),
	language: projectsIn("language").map((p) => p.name).join(", "),
	runtime: projectsIn("runtime").map((p) => p.name).join(", "),
	machine: projectsIn("machine").map((p) => p.name).join(", "),
};

// The last two layers invert: the page visibly gets deeper
const isDeep = (id: string) => id === "runtime" || id === "machine";
const layerSurface = (depth: string) => `background: var(--layer-${Number(depth)})`;

// Strongest skills first within each group
const levelRank: Record<string, number> = { Advanced: 0, Proficient: 1, Intermediate: 2 };
const skillsByCat = skills.reduce((acc, s) => {
	if (!acc[s.category]) acc[s.category] = [];
	acc[s.category].push(s);
	return acc;
}, {} as Record<string, typeof skills>);
for (const cat of Object.keys(skillsByCat)) {
	skillsByCat[cat].sort((a, b) => (levelRank[a.level.en] ?? 9) - (levelRank[b.level.en] ?? 9));
}
---

<Layout title={t.title} description={t.description} lang={lang}>
	<!-- HERO -->
	<section class="hero">
		<div class="container hero__inner" data-animate>
			<div class="hero__copy">
				<p class="hero__eyebrow">{t.eyebrow}</p>
				<h1 class="hero__title">Yanis <span>Amani</span></h1>
				<p class="hero__statement">{t.statement}</p>
				<p class="hero__desc">{t.heroDesc}</p>
				<div class="hero__cta">
					<a href="#projects" class="btn-primary">{t.ctaProjects}</a>
					<a href="#contact" class="btn-ghost">{t.ctaContact}</a>
				</div>
			</div>

			<nav class="stair" aria-label={t.stairLabel}>
				<ol>
					{layers.map((layer, i) => (
						<li style={`--step: ${i}`}>
							<a href={`#layer-${layer.id}`} class:list={["stair__row", { "surface-deep": isDeep(layer.id) }]} style={layerSurface(layer.depth)}>
								<span class="stair__depth">{layer.depth}</span>
								<span class="stair__name">{layer.name[lang]}</span>
								<span class="stair__proof">{stairProof[layer.id]}</span>
							</a>
						</li>
					))}
				</ol>
			</nav>
		</div>
	</section>

	<!-- ABOUT -->
	<section id="about" class="section intro">
		<div class="container intro__grid">
			<div class="intro__story">
				<h2 class="section-title">{t.about}</h2>
				<p class="intro__lead">{t.aboutLead}</p>
				<p class="intro__text">{t.aboutStory}</p>
				<p class="intro__text">{t.aboutText}</p>
			</div>
			<div class="intro__side">
				<h3 class="side-label">{t.factsLabel}</h3>
				<dl class="fact-list">
					{t.facts.map(([label, value]) => (
						<div><dt>{label}</dt><dd>{value}</dd></div>
					))}
				</dl>
				<div id="skills">
					<h3 class="side-label">{t.skills}</h3>
					<p class="side-sub">{t.skillsSub}</p>
					<dl class="fact-list">
						{Object.entries(skillsByCat).map(([cat, catSkills]) => (
							<div><dt>{categoryLabels[lang][cat] || cat}</dt><dd>{catSkills.map((s) => s.name).join(", ")}</dd></div>
						))}
					</dl>
				</div>
			</div>
		</div>
	</section>

	<!-- DEPTH GAUGE -->
	<nav class="gauge" id="gauge" aria-label={t.gaugeLabel}>
		<div class="container gauge__inner">
			{layers.map((layer) => (
				<a href={`#layer-${layer.id}`} class="gauge__step" data-gauge={layer.id}>
					<span class="gauge__depth">{layer.depth}</span>
					<span class="gauge__name">{layer.name[lang]}</span>
				</a>
			))}
		</div>
	</nav>

	<!-- THE DESCENT -->
	<div id="projects">
		{layers.map((layer) => (
			<section id={`layer-${layer.id}`} data-layer={layer.id} class:list={["layer", `layer--${layer.id}`, { "surface-deep": isDeep(layer.id) }]} style={layerSurface(layer.depth)}>
				<div class="container">
					<header class="layer__head">
						<span class="layer__depth" aria-hidden="true">{layer.depth}</span>
						<div>
							<h2 class="section-title">{layer.name[lang]}</h2>
							<p class="layer__claim">{layer.claim[lang]}</p>
						</div>
					</header>

					{layer.id === "surface" && (
						<div class="static-grid">
							{staticSites.map((site) => (
								<a href={site.url} target="_blank" rel="noopener noreferrer" class="static-card">
									<h3 class="static-card__name">{site.name}</h3>
									<p class="static-card__desc">{site.description[lang]}</p>
									<div class="static-card__tags">
										{site.tags.map((tag) => (
											<span class="mini-tag">{tag}</span>
										))}
									</div>
								</a>
							))}
						</div>
					)}

					<div class="exhibits">
						{projectsIn(layer.id).map((p) => (
							<article class="exhibit">
								<div class="exhibit__body">
									<span class="exhibit__cat">{p.category[lang]}{p.role && ` · ${p.role[lang]}`}</span>
									<h3 class="exhibit__name">
										<a href={`${projectBase}/${p.id}`} class="exhibit__link">{p.name}</a>
									</h3>
									<p class="exhibit__desc">{p.description[lang]}</p>
								</div>
								{p.facts.length > 0 && (
									<dl class="proof">
										{p.facts.map((fact) => (
											<div><dt>{fact.value}</dt><dd>{fact.label[lang]}</dd></div>
										))}
									</dl>
								)}
								<div class="exhibit__foot">
									<div class="exhibit__tags">
										{p.tags.map((tag) => (
											<a href={tag.url} target="_blank" rel="noopener noreferrer" class="tech-tag">{tag.name}</a>
										))}
									</div>
									<span class="exhibit__more" aria-hidden="true">{t.caseStudy}</span>
								</div>
							</article>
						))}
					</div>

					{layer.id === "language" && (
						<div class="lineage">
							<h3 class="side-label">{t.lineage}</h3>
							<ol class="lineage__list">
								{lineage.map((entry) => (
									<li>
										<span class="lineage__year">{entry.year}</span>
										<a href={entry.url} target="_blank" rel="noopener noreferrer" class="lineage__name">{entry.name}</a>
										<span class="lineage__note">{entry.note[lang]}</span>
									</li>
								))}
							</ol>
						</div>
					)}
				</div>
			</section>
		))}
	</div>

	<!-- CONTACT: the bottom of the stack -->
	<section id="contact" class="contact surface-deep" style="background: var(--layer-1)">
		<div class="container">
			<p class="contact__eyebrow"><span>00</span> {t.bottom}</p>
			<h2 class="contact__title">{t.contact}</h2>
			<p class="contact__sub">{t.contactSub}</p>
			<a href="mailto:yanis.amani@icloud.com" class="contact__email">yanis.amani@icloud.com</a>
			<div class="contact__socials">
				<a href="https://linkedin.com/in/yanis-amani" target="_blank" rel="me noopener noreferrer">LinkedIn</a>
				<a href="https://github.com/DevYatsu" target="_blank" rel="me noopener noreferrer">GitHub</a>
			</div>
		</div>
	</section>
</Layout>

<script>
	// The gauge reads the layer crossing mid-viewport; one observer per page visit
	document.addEventListener('astro:page-load', () => {
		const gauge = document.getElementById('gauge');
		if (!gauge) return;
		const steps = gauge.querySelectorAll<HTMLElement>('[data-gauge]');

		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				const id = (entry.target as HTMLElement).dataset.layer;
				const step = gauge.querySelector(`[data-gauge="${id}"]`);
				if (entry.isIntersecting) {
					steps.forEach((s) => s.removeAttribute('aria-current'));
					step?.setAttribute('aria-current', 'location');
					gauge.classList.add('is-active');
				} else if (step?.hasAttribute('aria-current')) {
					step.removeAttribute('aria-current');
					gauge.classList.remove('is-active');
				}
			}
		}, { rootMargin: '-50% 0px -50% 0px' });

		document.querySelectorAll('[data-layer]').forEach((el) => observer.observe(el));
		document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
	});
</script>

<style>
/* ═══════════════════════════════════════════
   Hallmark · genre: modern-minimal · macrostructure: Descent
   design-system: design.md · designed-as-app
   hero: type + stair (Tier-A CSS art) · surfaces step down, never blend
   nav: N1b · footer: Ft5
   ═══════════════════════════════════════════ */

/* ── Hero ── */
.hero {
  min-height: 92vh;
  display: flex;
  align-items: center;
  padding-block: calc(64px + var(--space-xl)) var(--space-xl);
}

.hero__inner {
  width: 100%;
  display: grid;
  gap: var(--space-xl);
}

@media (min-width: 1024px) {
  .hero__inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: end;
    gap: var(--space-2xl);
  }
}

.hero__eyebrow {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: var(--space-md);
}

.hero__title {
  font-size: clamp(3.5rem, 11vw, 7rem);
  font-weight: 700;
  letter-spacing: -0.045em;
  line-height: 0.88;
  margin-bottom: var(--space-md);
}

.hero__title span {
  display: block;
}

.hero__statement {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.15;
  color: var(--color-accent);
  margin-bottom: var(--space-sm);
}

.hero__desc {
  font-size: var(--text-md);
  color: var(--color-ink-2);
  line-height: 1.6;
  max-width: 34rem;
}

.hero__cta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

/* ── Stair: each row is a layer, shifted right as the stack goes down ── */
.stair ol {
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
}

.stair li {
  margin-left: calc(var(--step) * var(--stair-shift, 0.75rem));
}

@media (min-width: 640px) {
  .stair { --stair-shift: 1.75rem; }
}

.stair__row {
  display: grid;
  grid-template-columns: 2rem auto;
  column-gap: var(--space-2xs);
  align-items: baseline;
  padding: var(--space-xs) var(--space-sm);
  border: 1px solid var(--color-rule);
  border-radius: var(--radius-sm);
  color: var(--color-ink);
  text-decoration: none;
  transition: border-color var(--dur-short) var(--ease-out);
}

.stair__row:hover {
  border-color: var(--color-accent);
}

.stair__row:focus-visible {
  outline: 2px solid var(--color-focus);
  outline-offset: 2px;
}

.stair__depth {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-muted);
}

.stair__name {
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: 600;
  letter-spacing: -0.015em;
}

.stair__proof {
  grid-column: 2;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-ink-2);
}

/* ── Shared headings ── */
.section-title {
  font-size: var(--text-2xl);
  font-weight: 600;
}

.side-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: var(--space-xs);
}

.side-sub {
  font-size: var(--text-sm);
  color: var(--color-ink-2);
  margin-bottom: var(--space-xs);
}

/* ── About ── */
.intro {
  padding-block: var(--space-2xl);
  border-top: 1px solid var(--color-rule);
}

.intro__grid {
  display: grid;
  gap: var(--space-xl);
}

@media (min-width: 1024px) {
  .intro__grid {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-2xl);
  }
}

.intro__lead {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 600;
  letter-spacing: -0.015em;
  line-height: 1.3;
  margin-block: var(--space-md);
}

.intro__text {
  color: var(--color-ink-2);
  line-height: 1.7;
  margin-bottom: var(--space-sm);
  max-width: 40rem;
}

.intro__side {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.fact-list > div {
  display: grid;
  grid-template-columns: 8.5rem minmax(0, 1fr);
  gap: var(--space-sm);
  padding-block: var(--space-2xs);
  border-top: 1px solid var(--color-rule);
  font-size: var(--text-sm);
}

.fact-list dt {
  color: var(--color-muted);
}

.fact-list dd {
  margin: 0;
  color: var(--color-ink);
}

/* ── Depth gauge: fixed under the nav so it works at every width ── */
.gauge {
  position: fixed;
  inset: 64px 0 auto;
  z-index: 499;
  background: var(--color-paper-2);
  border-bottom: 1px solid var(--color-rule);
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--dur-short) var(--ease-out), visibility var(--dur-short);
}

.gauge.is-active {
  opacity: 1;
  visibility: visible;
}

@media (max-width: 767px) {
  .gauge { top: 56px; }
}

.gauge__inner {
  display: flex;
  justify-content: space-between;
  gap: var(--space-2xs);
}

.gauge__step {
  display: inline-flex;
  gap: 0.5em;
  padding-block: 0.4rem;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-muted);
  text-decoration: none;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
}

.gauge__step:hover,
.gauge__step[aria-current] {
  color: var(--color-accent);
}

.gauge__step[aria-current] {
  border-bottom-color: var(--color-accent);
}

.gauge__step:focus-visible {
  outline: 2px solid var(--color-focus);
  outline-offset: -2px;
}

/* Five labels don't fit a phone: only the current layer keeps its name */
@media (max-width: 639px) {
  .gauge__name { display: none; }
  .gauge__step[aria-current] .gauge__name { display: inline; }
}

/* ── Layers ── */
.layer {
  padding-block: var(--space-2xl);
  scroll-margin-top: 64px;
}

@media (min-width: 768px) {
  .layer { padding-block: var(--space-3xl); }
}

.layer__head {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  margin-bottom: var(--space-xl);
}

.layer__depth {
  font-family: var(--font-mono);
  font-size: clamp(3rem, 9vw, 5.25rem);
  line-height: 0.85;
  letter-spacing: -0.05em;
  color: var(--color-accent);
}

.layer__claim {
  font-size: var(--text-md);
  color: var(--color-ink-2);
  line-height: 1.5;
  max-width: 36rem;
  margin-top: var(--space-2xs);
}

/* ── Exhibits ── */
.exhibits {
  display: grid;
  gap: var(--space-md);
}

.exhibits:empty {
  display: none;
}

@media (min-width: 768px) {
  .layer--product .exhibits {
    grid-template-columns: 1fr 1fr;
  }
}

.exhibit {
  position: relative;
  display: grid;
  gap: var(--space-md);
  padding: var(--space-md);
  border: 1px solid var(--color-rule);
  border-radius: var(--radius-lg);
  background: var(--color-paper-2);
  transition: border-color var(--dur-short) var(--ease-out);
}

@media (min-width: 768px) {
  .exhibit { padding: var(--space-lg); }
}

.exhibit:hover {
  border-color: var(--color-accent);
}

/* Light product/language layers are already tinted: the card lifts back to paper */
.layer--product .exhibit,
.layer--language .exhibit {
  background: var(--color-paper);
}

.exhibit__cat {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: var(--space-2xs);
}

.exhibit__name {
  font-size: var(--text-2xl);
  letter-spacing: -0.03em;
  margin-bottom: var(--space-xs);
}

.exhibit__link {
  color: inherit;
  text-decoration: none;
}

/* Stretched link: the whole card is clickable without nesting anchors */
.exhibit__link::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: var(--radius-lg);
}

.exhibit__link:focus-visible {
  outline: none;
}

.exhibit__link:focus-visible::after {
  outline: 2px solid var(--color-focus);
  outline-offset: 2px;
}

.exhibit__desc {
  color: var(--color-ink-2);
  line-height: 1.6;
  max-width: 44rem;
}

.proof {
  display: grid;
  gap: var(--space-sm);
  margin: 0;
}

@media (min-width: 640px) {
