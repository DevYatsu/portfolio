---
import type { Language } from "../types";

interface Props {
	lang?: Language;
}

const { lang = "en" } = Astro.props;

const t = {
	en: { projects: "Projects", stack: "Stack", about: "About", contact: "Contact", switchLang: "Voir en français", theme: "Toggle theme" },
	fr: { projects: "Projets", stack: "Outils", about: "À propos", contact: "Contact", switchLang: "View in English", theme: "Changer de thème" },
}[lang];

const home = lang === "fr" ? "/fr/" : "/";

// Counterpart URL for the language toggle — same page, other locale
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const altPath =
	lang === "fr"
		? path.replace(/^\/fr(?=\/|$)/, "") || "/"
		: path === "/"
			? "/fr/"
			: `/fr${path}`;
const altLang = lang === "fr" ? "en" : "fr";
const altLabel = lang === "fr" ? "EN" : "FR";
---

<header class="nav">
	<div class="nav__inner">
		<a href={home} class="nav__brand">YA</a>

		<nav class="nav__center">
			<a href={`${home}#projects`} class="nav__link">{t.projects}</a>
			<a href={`${home}#skills`} class="nav__link">{t.stack}</a>
			<a href={`${home}#about`} class="nav__link">{t.about}</a>
			<a href={`${home}#contact`} class="nav__link">{t.contact}</a>
		</nav>

		<div class="nav__right">
			<button class="nav__theme" id="theme-toggle" aria-label={t.theme}>
				<span class="theme-icon-light">☀</span>
				<span class="theme-icon-dark">☾</span>
			</button>
			<a
				class="nav__lang"
				href={altPath}
				aria-label={t.switchLang}
				onclick={`localStorage.setItem('lang','${altLang}')`}
			>{altLabel}</a>
			<button id="mob-btn" class="mob-btn" aria-label="Toggle menu" aria-expanded="false">
				<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
				</svg>
			</button>
		</div>
	</div>

	<div id="mob-menu" class="mob-menu hidden">
		<div class="container">
			<a href={`${home}#projects`} class="mob-link">{t.projects}</a>
			<a href={`${home}#skills`} class="mob-link">{t.stack}</a>
			<a href={`${home}#about`} class="mob-link">{t.about}</a>
			<a href={`${home}#contact`} class="mob-link">{t.contact}</a>
			<hr class="mob-rule">
			<a
				class="mob-lang"
				href={altPath}
				onclick={`localStorage.setItem('lang','${altLang}')`}
			>{lang === "fr" ? "English" : "Français"}</a>
		</div>
	</div>
</header>

<script>
	const scrollBehavior = () =>
		window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

	// window-level listeners register once at module scope —
	// astro:page-load fires on every ClientRouter navigation and would
	// otherwise stack a new copy of each listener per navigation.
	let ticking = false;
	window.addEventListener('scroll', () => {
		if (ticking) return;
		ticking = true;
		window.requestAnimationFrame(() => {
			document.querySelector('.nav')?.classList.toggle('is-scrolled', window.scrollY > 24);
			ticking = false;
		});
	});

	const normalize = (p) => p.replace(/\/$/, '') || '/';

	document.addEventListener('astro:page-load', () => {
		document.querySelector('.nav')?.classList.toggle('is-scrolled', window.scrollY > 24);

		// Mobile menu
		const btn = document.getElementById('mob-btn');
		const menu = document.getElementById('mob-menu');
		if (!btn || !menu) return;

		const iconClosed = '<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>';
		const iconOpen = '<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>';

		let open = false;
		const setOpen = (next) => {
			open = next;
			menu.classList.toggle('hidden', !open);
			btn.setAttribute('aria-expanded', String(open));
			btn.innerHTML = open ? iconOpen : iconClosed;
		};
		setOpen(false);

		btn.addEventListener('click', () => setOpen(!open));

		const header = btn.closest('header');

		// Escape closes the menu and returns focus to the toggle
		header?.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && open) {
				setOpen(false);
				btn.focus();
			}
		});

		// Same-page hash links scroll with a fixed-nav offset
		header?.addEventListener('click', (e) => {
			const link = e.target.closest('a');
			if (!link || !link.hash) return;
			const url = new URL(link.href);
			if (normalize(url.pathname) !== normalize(location.pathname)) return;
			const el = document.getElementById(url.hash.substring(1));
			if (!el) return;
			e.preventDefault();
			history.replaceState(null, '', url.pathname + url.hash);
			const top = el.getBoundingClientRect().top + window.scrollY - 80;
			window.scrollTo({ top, behavior: scrollBehavior() });
			if (open) setOpen(false);
		});

		// Reload hash scroll
		if (window.location.hash) {
			const el = document.getElementById(window.location.hash.substring(1));
			if (el) {
				requestAnimationFrame(() => {
					const top = el.getBoundingClientRect().top + window.scrollY - 80;
					window.scrollTo({ top, behavior: scrollBehavior() });
				});
			}
		}
	});
</script>

<style>
	/* ═══ N1b Canonical SaaS Nav ═══ */
	.nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 500;
		height: 64px;
		background: transparent;
		transition: background var(--dur-short) var(--ease-out),
		            backdrop-filter var(--dur-short) var(--ease-out),
		            border-color var(--dur-short) var(--ease-out);
	}

	.nav.is-scrolled {
		background: color-mix(in srgb, var(--color-paper) 72%, transparent);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		border-bottom: 1px solid var(--color-rule);
	}

	.nav__inner {
		max-width: 72rem;
		margin: 0 auto;
		padding-inline: var(--space-md);
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	@media (min-width: 768px) {
		.nav__inner {
			padding-inline: var(--space-xl);
		}
	}

	.nav__brand {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: -0.02em;
		color: var(--color-ink);
		text-decoration: none;
		display: flex;
		align-items: center;
		gap: 0.1em;
	}

	.nav__center {
		display: flex;
		gap: var(--space-2xs);
	}

	.nav__link {
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--color-ink-2);
		text-decoration: none;
		padding: 0.35rem 0.65rem;
		border-radius: var(--radius-pill);
		white-space: nowrap;
		transition: color var(--dur-short) var(--ease-out),
		            background var(--dur-short) var(--ease-out);
	}

	.nav__link:hover {
		color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 6%, transparent);
	}

	.nav__link:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
	}

	.nav__right {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
	}

	.nav__theme,
	.nav__lang {
		background: none;
		border: none;
		padding: 0.35rem 0.5rem;
		border-radius: var(--radius-pill);
		color: var(--color-muted);
		cursor: pointer;
		font-size: var(--text-sm);
		font-family: var(--font-body);
		text-decoration: none;
		transition: color var(--dur-short) var(--ease-out);
	}

	.nav__theme:hover,
	.nav__lang:hover {
		color: var(--color-accent);
	}

	.nav__theme:focus-visible,
	.nav__lang:focus-visible,
	.mob-btn:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
	}

	.nav__theme .theme-icon-dark {
		opacity: 0.35;
		transition: opacity var(--dur-short) var(--ease-out);
	}

	.nav__theme.dark .theme-icon-dark {
		opacity: 1;
		color: var(--color-accent);
	}

	.nav__theme.dark .theme-icon-light {
		opacity: 0.35;
	}

	.nav__lang {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: var(--text-xs);
	}

	/* ── Mobile ── */
	.mob-btn {
		display: none;
		background: none;
		border: none;
		padding: 0.375rem;
		color: var(--color-ink-2);
		cursor: pointer;
		touch-action: manipulation;
	}

	@media (max-width: 767px) {
		.nav {
			height: 56px;
		}

		.nav__center {
			display: none;
		}

		/* Keep the theme toggle reachable on mobile; language switch
		   lives in the mobile menu. */
		.nav__lang {
			display: none;
		}

		.mob-btn {
			display: flex;
			align-items: center;
			justify-content: center;
		}
	}

	.hidden { display: none; }

	.mob-menu {
		position: fixed;
		top: 64px;
		left: 0;
		right: 0;
		z-index: 500;
		background: color-mix(in srgb, var(--color-paper) 96%, transparent);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		border-bottom: 1px solid var(--color-rule);
		box-shadow: 0 8px 32px rgba(0,0,0,0.08);
	}

	@media (max-width: 767px) {
		.mob-menu {
			top: 56px;
		}
	}

	.mob-link {
		display: block;
		font-family: var(--font-display);
		font-size: 1.25rem;
		padding: var(--space-sm) var(--space-md);
		color: var(--color-ink);
		text-decoration: none;
		transition: color var(--dur-short) var(--ease-out);
	}

	.mob-link:hover {
		color: var(--color-accent);
	}

	.mob-rule {
		border: none;
		height: 1px;
		background: var(--color-rule);
		margin: var(--space-xs) var(--space-md);
	}

	.mob-lang {
		display: block;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		background: none;
		border: none;
		padding: var(--space-sm) var(--space-md);
		cursor: pointer;
		text-align: left;
		text-decoration: none;
		transition: color var(--dur-short) var(--ease-out);
	}
</style>
