---
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/globals.css";

import Header from "../components/Header.astro";
import { ClientRouter } from "astro:transitions";
import { projects } from "../data/portfolio";
import { routePath } from "../lib/route";
import type { Language } from "../types";

interface Props {
	title: string;
	description?: string;
	/** Opt out of indexing on an otherwise indexable route. */
	noindex?: boolean;
	/** Opt in to indexing on an otherwise excluded route. */
	index?: boolean;
	lang?: Language;
	/** Emit hreflang alternate links (default true: off for 404). */
	alternates?: boolean;
	/** Override canonical URL path. Uses siteUrl as base. */
	canonical?: string;
	/** Breadcrumbs for BreadcrumbList structured data */
	breadcrumbs?: { name: string; path: string }[];
}

const defaultDescriptions: Record<Language, string> = {
	en: "Official portfolio of Yanis Amani, Computer Science student majoring in Software Engineering. Systems programming, Rust, TypeScript, and reliable software.",
	fr: "Portfolio officiel de Yanis Amani, étudiant en informatique, spécialisation génie logiciel. Programmation système, Rust, TypeScript et logiciels fiables.",
};

const {
	title,
	lang = "en",
	description = defaultDescriptions[lang],
	noindex = false,
	index = false,
	alternates = true,
	canonical,
	breadcrumbs,
} = Astro.props;

// Single source of truth: `site` in astro.config.mjs
const siteUrl = Astro.site!.origin;

const currentPath = routePath(Astro.url.pathname);

// Default-deny indexing: the index roots are indexable, other pages opt in.
// This matches / and /fr plus trailing-slash aliases, and excludes every
// nested route (/projects/*) — including renamed locale prefixes
// (e.g. /de) and future pages, which stay noindex unless they opt in.
const indexRoot = currentPath;
const indexableRoot = indexRoot === "/" || indexRoot === "/fr";

// An explicit noindex always wins; otherwise the index root or a page-level
// `index` opt-in is required.
const robots = !noindex && (indexableRoot || index) ? "index, follow" : "noindex, follow";

// Per-page canonical URL: strip trailing slash to match internal link format
const canonicalPath = canonical !== undefined ? canonical : currentPath;
const pageUrl = new URL(canonicalPath, siteUrl);

// hreflang pair: the FR tree mirrors the EN tree under /fr
const enPath = lang === "fr" ? (canonicalPath.replace(/^\/fr(?=\/|$)/, "") || "/") : canonicalPath;
const frPath = enPath === "/" ? "/fr" : `/fr${enPath}`;
const enUrl = new URL(enPath, siteUrl);
const frUrl = new URL(frPath, siteUrl);

const footer = {
	en: { line: "Build software that doesn't break.", skip: "Skip to content" },
	fr: { line: "Construire des logiciels qui ne cassent pas.", skip: "Aller au contenu" },
}[lang];

// JSON-LD structured data
const person = {
	"@type": "Person",
	"@id": `${siteUrl}/#person`,
	name: "Yanis Amani",
	givenName: "Yanis",
	familyName: "Amani",
	alternateName: "DevYatsu",
	jobTitle: "Computer Science Student",
	// alumniOf would claim a finished degree; affiliation fits a current student.
	affiliation: {
		"@type": "CollegeOrUniversity",
		name: "HE-Arc",
		url: "https://www.he-arc.ch",
	},
	address: {
		"@type": "PostalAddress",
		addressLocality: "Neuchâtel",
		addressCountry: "CH",
	},
	knowsAbout: [
		"Rust",
		"TypeScript",
		"Systems programming",
		"Compilers",
		"JavaScript engines",
		"Just-in-time compilation",
		"Emulation",
		"Software engineering",
	],
	memberOf: {
		"@type": "Organization",
		name: "WIE Project",
		url: "https://github.com/wie-project",
	},
	url: siteUrl,
	email: "yanis.amani@icloud.com",
	sameAs: [
		"https://www.linkedin.com/in/yanis-amani",
		"https://github.com/DevYatsu",
	],
};

// Homepages are the profile pages Google should attach to the person entity.
const identitySchema = indexableRoot
	? {
		"@context": "https://schema.org",
		"@type": "ProfilePage",
		url: pageUrl,
		inLanguage: lang,
		dateModified: new Date().toISOString(),
		mainEntity: person,
	}
	: { "@context": "https://schema.org", ...person };

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${siteUrl}/#website`,
	name: "Yanis Amani Portfolio",
	url: siteUrl,
	description: defaultDescriptions[lang],
	inLanguage: lang,
	author: { "@id": `${siteUrl}/#person` },
};

// Links each repository to the person entity, which separates the name from namesakes.
// The contributor/author split keeps WIE's co-developer credit accurate.
const worksSchema = indexableRoot ? {
	"@context": "https://schema.org",
	"@type": "ItemList",
	itemListElement: projects.filter((p) => p.link.url.includes("github.com")).map((p, index) => ({
		"@type": "ListItem",
		position: index + 1,
		item: {
			"@type": "SoftwareSourceCode",
			name: p.name,
			description: p.description[lang],
			codeRepository: p.link.url,
			[p.role ? "contributor" : "author"]: { "@id": `${siteUrl}/#person` },
		},
	})),
} : null;

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: breadcrumbs.map((crumb, index) => ({
		"@type": "ListItem",
		position: index + 1,
		name: crumb.name,
		item: new URL(crumb.path, siteUrl).toString(),
	})),
} : null;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<ClientRouter />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#f0f5ff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a0d13" media="(prefers-color-scheme: dark)" />

		<link rel="canonical" href={pageUrl} />

		{alternates && (
			<>
				<link rel="alternate" hreflang="en" href={enUrl} />
				<link rel="alternate" hreflang="fr" href={frUrl} />
				<link rel="alternate" hreflang="x-default" href={enUrl} />
			</>
		)}

		{/* Homepages and opted-in case studies index; every other route opts out. */}
		<meta name="robots" content={robots} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:site_name" content="Yanis Amani" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/og-image.png', siteUrl)} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Yanis Amani. From the pixel to the register" />
		<meta property="og:locale" content={lang === "fr" ? "fr_CH" : "en_GB"} />
		<meta property="og:locale:alternate" content={lang === "fr" ? "en_GB" : "fr_CH"} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={pageUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL('/og-image.png', siteUrl)} />

		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(identitySchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
		{worksSchema && (
			<script type="application/ld+json" set:html={JSON.stringify(worksSchema)}></script>
		)}
		{breadcrumbSchema && (
			<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
		)}

		<!-- Reveal animations depend on JS; never hide content without it -->
		<noscript>
			<style>
				[data-animate] { opacity: 1 !important; transform: none !important; }
			</style>
		</noscript>
	</head>
	<body>
		<a href="#main-content" class="skip-link">{footer.skip}</a>
		<div class="page-wrap">
			<Header lang={lang} />

			<main id="main-content" class="main-content">
				<slot />
			</main>

			<footer class="foot-stmt">
				<p class="foot-stmt__line">{footer.line}</p>
				<div class="foot-stmt__meta">
					<span class="foot-stmt__copy">&copy; {new Date().getFullYear()} Yanis Amani</span>
					<div class="foot-stmt__links">
						<a href="https://github.com/DevYatsu" target="_blank" rel="me noopener noreferrer" class="foot-stmt__link">GitHub</a>
						<a href="https://linkedin.com/in/yanis-amani" target="_blank" rel="me noopener noreferrer" class="foot-stmt__link">LinkedIn</a>
					</div>
				</div>
			</footer>
		</div>

		<script is:inline data-astro-rerun>
			// Theme: match stored/browser preference before paint
			(function() {
				var stored = localStorage.getItem('theme');
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (stored === 'dark' || (!stored && prefersDark)) {
					document.documentElement.setAttribute('data-theme', 'dark');
				} else if (stored === 'light') {
					document.documentElement.setAttribute('data-theme', 'light');
				}
			})();
		</script>

		<script>
			// Theme toggle handler
			document.addEventListener('astro:page-load', () => {
				const btn = document.getElementById('theme-toggle');
				const html = document.documentElement;

				const updateIcon = () => {
					const isDark = html.getAttribute('data-theme') === 'dark';
					btn?.classList.toggle('dark', isDark);
					btn?.setAttribute('aria-pressed', String(isDark));
				};

				btn?.addEventListener('click', () => {
					const isDark = html.getAttribute('data-theme') === 'dark';
					if (isDark) {
						html.setAttribute('data-theme', 'light');
						localStorage.setItem('theme', 'light');
					} else {
						html.setAttribute('data-theme', 'dark');
						localStorage.setItem('theme', 'dark');
					}
					updateIcon();
				});

				window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
					if (!localStorage.getItem('theme')) {
						html.setAttribute('data-theme', e.matches ? 'dark' : 'light');
						updateIcon();
					}
				});

				updateIcon();
			});
		</script>

		<script>
			// Scroll-triggered reveal animations
			document.addEventListener('astro:page-load', () => {
				const observer = new IntersectionObserver((ents) => {
					ents.forEach(e => {
						if (e.isIntersecting) {
							(e.target).classList.add('visible');
							observer.unobserve(e.target);
						}
					});
				}, { threshold: 0.1 });

				document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));
			});
		</script>

		<!-- Mermaid: loaded on demand, only on pages that contain a diagram -->
		<script is:inline>
			(function() {
				var MERMAID_SRC = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
				var loading = null;

				function loadMermaid() {
					if (typeof mermaid !== 'undefined') return Promise.resolve();
					if (loading) return loading;
					loading = new Promise(function(resolve, reject) {
						var s = document.createElement('script');
						s.src = MERMAID_SRC;
						s.onload = resolve;
						s.onerror = reject;
						document.head.appendChild(s);
					});
					return loading;
				}

				function initMermaid() {
					const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
					const paper = isDark ? '#0a0d13' : '#f0f5ff';
					const paper2 = isDark ? '#13161d' : '#e6ebf6';
					const ink2 = isDark ? '#95989f' : '#3f4348';
					const rule = isDark ? '#21242b' : '#ccd1da';
					const accent = isDark ? '#348ff9' : '#026fd7';
					const muted = isDark ? '#8b8f97' : '#5a5e63';

					mermaid.initialize({
						startOnLoad: false,
						theme: 'base',
						themeVariables: {
							primaryColor: accent,
							primaryTextColor: isDark ? '#0f121c' : '#f2f4f7',
							primaryBorderColor: accent,
							lineColor: muted,
							secondaryColor: paper2,
							tertiaryColor: paper,
							fontFamily: 'ui-sans-serif, system-ui, sans-serif',
							fontSize: '14px',
							background: paper,
							mainBkg: paper2,
							nodeBorder: rule,
							clusterBkg: paper,
							clusterBorder: rule,
							titleColor: isDark ? '#eef0f4' : '#141b2c',
							edgeLabelBackground: paper2,
							nodeTextColor: ink2,
						},
					});
					document.querySelectorAll('.mermaid').forEach(el => {
						// Stash the diagram source before the SVG replaces it,
						// so theme-toggle re-renders still have the source text.
						if (!el.dataset.src) el.dataset.src = el.textContent.trim();
						mermaid.render(el.id || 'mermaid-' + Math.random().toString(36).slice(2), el.dataset.src)
							.then(({ svg }) => {
								el.innerHTML = svg;
							});
					});
				}

				function renderIfPresent() {
					if (!document.querySelector('.mermaid')) return;
					// Wait for webfonts: Mermaid sizes node boxes from measured
					// text, so rendering with fallback metrics clips the labels.
					var fonts = document.fonts ? document.fonts.ready : Promise.resolve();
					Promise.all([loadMermaid(), fonts]).then(initMermaid).catch(function() {});
				}

				document.addEventListener('astro:page-load', renderIfPresent);

				// Re-render on theme toggle
				const themeObserver = new MutationObserver(() => {
					if (typeof mermaid !== 'undefined' && document.querySelector('.mermaid[data-src]')) {
						initMermaid();
					}
				});
				themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
			})();
		</script>
	</body>
</html>

<style>
	.page-wrap {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.main-content {
		flex: 1;
		padding-top: 0;
	}

	/* ── Footer (Ft5 Statement) ── */
	.foot-stmt {
		padding: var(--space-2xl) var(--space-md) var(--space-xl);
		max-width: 72rem;
		margin: 0 auto;
		border-top: 1px solid var(--color-rule);
	}

	@media (min-width: 768px) {
		.foot-stmt {
			padding-left: var(--space-xl);
			padding-right: var(--space-xl);
		}
	}

	.foot-stmt__line {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 4vw, 2.75rem);
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.02em;
		max-width: 28ch;
		margin: 0 0 var(--space-lg);
		color: var(--color-ink);
	}

	.foot-stmt__meta {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		padding-top: var(--space-md);
		border-top: 1px solid var(--color-rule);
		font-size: var(--text-sm);
		color: var(--color-muted);
		font-family: var(--font-body);
	}

	@media (min-width: 768px) {
		.foot-stmt__meta {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}
	}

	.foot-stmt__links {
		display: flex;
		gap: var(--space-md);
	}

	.foot-stmt__link {
		color: var(--color-muted);
		text-decoration: none;
		transition: color var(--dur-short) var(--ease-out);
	}

	.foot-stmt__link:hover {
		color: var(--color-accent);
	}
</style>
